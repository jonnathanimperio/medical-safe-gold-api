JWT_SECRET = os.environ.get("JWT_SECRET", secrets.token_urlsafe(64))
JWT_ALGORITHM = "HS256"
JWT_EXPIRE_HOURS = 24
TRIAL_DAYS = 7
DB_NAME = "medical_safe_gold"

# --- App ---
app = FastAPI(title="Medical Safe Gold API", version="1.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
