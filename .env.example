# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Master encryption key for Fernet - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=YOUR_FERNET_MASTER_KEY

# JWT secret - auto-generated if not set, but set a fixed value for production
JWT_SECRET=your-jwt-secret-here

# Admin API key for license management endpoints
ADMIN_KEY=your-admin-key-here

# Mercado Pago Access Token (required for payments)
MP_ACCESS_TOKEN=APP_USR-your-access-token-here

# Backend URL (for webhook and redirect URLs)
BACKEND_URL=https://web-production-2043d.up.railway.app

# Frontend URL (for redirect after payment)
FRONTEND_URL=https://medicalsafegold.com

# SMTP settings for sending license keys and password reset emails (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
